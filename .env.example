# Copy to .env and fill in, then: chmod 600 .env
#
# .env is gitignored and never logged. The password is loaded as a SecretStr,
# so it cannot reach a repr, a log line or a traceback.

# --- dpchallenge login (only needed by `dpc scrape`) ---
DPC_USERNAME=your-dpchallenge-username
DPC_PASSWORD=your-dpchallenge-password

# --- optional overrides; the defaults below are what you get if omitted ---
# DPC_DATABASE_URL=sqlite+pysqlite:///dpc.sqlite
# DPC_CACHE_DIR=dpc_cache
# DPC_SITE_DIR=site
# DPC_REQUEST_TIMEOUT=30.0
# DPC_MAX_RETRIES=5

# --- scraping speed ---
# The delay is per fetch worker, not global, so the aggregate request rate is
# roughly DPC_FETCH_WORKERS / DPC_REQUEST_DELAY per second -- 80/s at these
# defaults. Raise the delay or lower the workers to be gentler.
# DPC_REQUEST_DELAY=0.1
# DPC_FETCH_WORKERS=8
#
# Processes for parsing fetched HTML (~14 ms/page). 0 parses in-process, which
# is right unless fetching is fast enough that parsing dominates.
# DPC_PARSE_WORKERS=0
