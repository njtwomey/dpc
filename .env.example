# Copy to .env and fill in. .env is gitignored and never logged.

# --- dpchallenge login (only needed by `dpc scrape`) ---
DPC_USERNAME=your-dpchallenge-username
DPC_PASSWORD=your-dpchallenge-password

# --- optional overrides; the defaults below are what you get if omitted ---
# DPC_DATABASE_URL=sqlite+pysqlite:///dpc.sqlite
# DPC_CACHE_DIR=downloaded
# DPC_SITE_DIR=site
# DPC_REQUEST_TIMEOUT=30.0
# DPC_REQUEST_DELAY=1.0
# DPC_MAX_RETRIES=5
