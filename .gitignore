# ---------------------------------------------------------------- secrets
# Anything .env-shaped stays out, with the committed template as the one
# exception. .env itself was tracked until recently: `git check-ignore -v .env`
# is the way to confirm a rule is actually taking effect, because gitignore
# never applies to a file already in the index.
.env
.env.*
!.env.example

# ----------------------------------------------------------------- python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# uv manages .venv; uv.lock is committed on purpose.
.venv/
.python-version.local

# ----------------------------------------------------------------- caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ------------------------------------------------------------- local data
# The database and the scraped HTML cache stay local. They hold other members'
# comments in bulk, and git keeps every version forever.
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
dpc_cache/
database-backup/

# backups/sql IS committed: plain SQL, one file per table, so git diffs and
# delta-compresses the actual values. comments is filtered to those that granted
# an award, which is what keeps it to ~58 MB rather than gigabytes.
# The award-scoped variant is a local convenience, not a second copy in history.
backups/sql-awards/

# ------------------------------------------------------------------- hugo
site/public/
site/resources/
site/.hugo_build.lock

# ---------------------------------------------------------- editors and OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
nvim.log
