# ---------------------------------------------------------------- secrets
# Anything .env-shaped stays out, with the committed template as the one
# exception. .env itself was tracked until recently: `git check-ignore -v .env`
# is the way to confirm a rule is actually taking effect, because gitignore
# never applies to a file already in the index.
.env
.env.*
!.env.example

# ----------------------------------------------------------------- python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# uv manages .venv; uv.lock is committed on purpose.
.venv/
.python-version.local

# ----------------------------------------------------------------- caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ------------------------------------------------------------- local data
# The database, its snapshots and the scraped HTML cache stay local. They hold
# other members' comments, so they are not ours to publish -- and git keeps
# every version forever, which is the opposite of what a backup wants.
# The JSON under site/data/dpc IS committed: it is the site's build input.
database-backup/
backups/
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sql
dpc_cache/

# ------------------------------------------------------------------- hugo
site/public/
site/resources/
site/.hugo_build.lock

# ---------------------------------------------------------- editors and OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
nvim.log
